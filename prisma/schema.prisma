// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Campaign {
  id             String          @id @default(cuid())
  name           String
  system         String
  description    String
  coverImage     String?
  startDate      DateTime
  createdAt      DateTime        @default(now())
  characters     Character[]
  artworks       Artwork[]
  artworkFolders ArtworkFolder[]
  npcs           Npc[]
  npcFolders     NpcFolder[]
  sessions       Session[]
  messages       Message[]
  folders        DiaryFolder[]
  entries        DiaryEntry[]
  auditLogs      AuditLog[]
  addedBy        String?
  updatedBy      String?
}

model Character {
  id             String       @id @default(cuid())
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name           String
  player         String
  image          String?
  race           String
  characterClass String
  description    String
  createdAt      DateTime     @default(now())
  messages       Message[]
  entries        DiaryEntry[]
  addedBy        String?
  updatedBy      String?
}

model ArtworkFolder {
  id             String          @id @default(cuid())
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   ArtworkFolder?  @relation("ArtworkFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subfolders     ArtworkFolder[] @relation("ArtworkFolderHierarchy")
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  artworks       Artwork[]
  addedBy        String?
  updatedBy      String?
}

model Artwork {
  id          String         @id @default(cuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      ArtworkFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title       String
  image       String
  artist      String
  description String
  date        DateTime
  createdAt   DateTime       @default(now())
  addedBy     String?
  updatedBy   String?
  comments    Comment[]
  reactions   Reaction[]
}

model Session {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title        String
  summary      String
  date         DateTime
  participants String // Nomes separados por vírgula, ex: "Theron (Lucas), Aria (Maria)"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addedBy      String?
  updatedBy    String?
}

model Message {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String?
  content     String
  author      String
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  eventDate   DateTime?
  image       String?
  type        String // e.g. "Mensagem pessoal", "Pensamento", etc.
  createdAt   DateTime   @default(now())
  addedBy     String?
  updatedBy   String?
  comments    Comment[]
  reactions   Reaction[]
}

model DiaryFolder {
  id             String        @id @default(cuid())
  campaignId     String
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   DiaryFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subfolders     DiaryFolder[] @relation("FolderHierarchy")
  name           String
  description    String?
  createdAt      DateTime      @default(now())
  entries        DiaryEntry[]
  addedBy        String?
  updatedBy      String?
}

model DiaryEntry {
  id                 String       @id @default(cuid())
  campaignId         String
  campaign           Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folderId           String?
  folder             DiaryFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title              String
  content            String // Rich text (HTML) with images
  imageUrl           String?
  imageStyle         String       @default("medieval")
  fontFamily         String       @default("inter")
  author             String
  relatedCharacterId String?
  relatedCharacter   Character?   @relation(fields: [relatedCharacterId], references: [id], onDelete: SetNull)
  date               DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  addedBy            String?
  updatedBy          String?
  comments    Comment[]
  reactions   Reaction[]
}

model NpcFolder {
  id             String      @id @default(cuid())
  campaignId     String
  campaign       Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   NpcFolder?  @relation("NpcFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subfolders     NpcFolder[] @relation("NpcFolderHierarchy")
  name           String
  description    String?
  createdAt      DateTime    @default(now())
  npcs           Npc[]
  addedBy        String?
  updatedBy      String?
}

model Npc {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      NpcFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name        String
  race        String?
  occupation  String?
  description String
  image       String?
  createdAt   DateTime   @default(now())
  addedBy     String?
  updatedBy   String?
  comments    Comment[]
  reactions   Reaction[]
}

model AuditLog {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       String
  action     String // CREATE, UPDATE, DELETE
  entityType String // Personagem, NPC, Arte, etc
  entityName String
  details    String?
  createdAt  DateTime @default(now())
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  author      String
  createdAt   DateTime @default(now())

  artworkId   String?
  artwork     Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  npcId       String?
  npc         Npc?     @relation(fields: [npcId], references: [id], onDelete: Cascade)
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  diaryEntryId String?
  diaryEntry  DiaryEntry? @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
}

model Reaction {
  id          String   @id @default(cuid())
  emoji       String
  user        String

  artworkId   String?
  artwork     Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  npcId       String?
  npc         Npc?     @relation(fields: [npcId], references: [id], onDelete: Cascade)
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  diaryEntryId String?
  diaryEntry  DiaryEntry? @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
}
